# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://inventory_user:inventory_pass@localhost:5432/smart_inventory

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Model storage
MODEL_DIR=./model_store

# Exponential decay half-life (days) used to derive lambda for recency weighting
DECAY_HALF_LIFE_DAYS=60
